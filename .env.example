TELEGRAM_BOT_TOKEN=

# claude | claude-cli | openai | gcloud (auto-detected from available keys if unset)
VISION_PROVIDER=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Path to the Google service account key JSON (share the spreadsheet with its email)
GOOGLE_CREDENTIALS_FILE=expense-tracer-sa.json

SPREADSHEET_ID=
SHEET_NAME=Transaction 2026

# Pocket tracker cells the bot adds GoPay/BRI/cash spending to (defaults shown)
POCKET_CELL_BRI=Monthly Expense!J4
POCKET_CELL_CASH=Monthly Expense!J5
POCKET_CELL_GOPAY=Monthly Expense!J8
# Pocket tracker range read by /pockets
POCKET_TABLE=Monthly Expense!F3:K40

# Docker + VISION_PROVIDER=claude-cli: token from `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
